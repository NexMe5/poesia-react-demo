# Cache rules for Netlify and Cloudflare Pages (Vercel reads vercel.json).
# Hashed build files never change: cache for a year. Pages, sitemap and the service worker: always revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/privacy-policy
  Cache-Control: no-cache
/terms
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
